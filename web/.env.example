# Browser-visible API base URL (the FastAPI service).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL used by NextAuth to verify credentials (defaults to NEXT_PUBLIC_API_URL).
SNIPZO_API_URL=http://localhost:8000
# Auth.js / NextAuth settings. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
