# Browser-visible API base URL (the FastAPI service).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side API URL used by NextAuth to verify credentials (defaults to NEXT_PUBLIC_API_URL).
SNIPZO_API_URL=http://localhost:8000
# Auth.js / NextAuth settings. Generate a secret with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me
# Canonical public site URL for SEO metadata, OpenGraph, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Support/contact email displayed in footer and legal pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@snipzo.app
# Optional privacy-friendly analytics (Plausible). Leave unset to keep analytics completely off.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=snipzo.app
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
