# Copy this file to .env and fill in values as needed.
# All settings are optional at this stage; defaults are shown.

# Working directory for projects, transcripts, clips, and renders.
SNIPZO_WORK_DIR=./data

# Anthropic API key for clip selection and metadata. If unset, a heuristic is used.
SNIPZO_ANTHROPIC_API_KEY=
SNIPZO_ANTHROPIC_MODEL=claude-sonnet-4-5

# Highlight selection.
SNIPZO_CLIP_COUNT=5
SNIPZO_CLIP_MIN_SECONDS=20
SNIPZO_CLIP_MAX_SECONDS=60


# Transcription backend: faster-whisper (local, default) or deepgram (hosted).
SNIPZO_TRANSCRIBER=faster-whisper

# faster-whisper model size. "base" or "small" is recommended for CPU demos.
# Use "large-v3" when a GPU is available.
SNIPZO_WHISPER_MODEL=base

# Required only when SNIPZO_TRANSCRIBER=deepgram.
SNIPZO_DEEPGRAM_API_KEY=

# Caption style: bold-yellow or clean-white.
SNIPZO_CAPTION_STYLE=bold-yellow

# Logging level: DEBUG, INFO, WARNING, ERROR.
SNIPZO_LOG_LEVEL=INFO

# --- API, workers, and storage (pip install -e ".[api]") ---
# SQLite works for local dev; docker-compose uses Postgres.
SNIPZO_DATABASE_URL=sqlite:///./data/snipzo.db
# SNIPZO_DATABASE_URL=postgresql+psycopg://snipzo:snipzo@localhost:5432/snipzo
SNIPZO_REDIS_URL=redis://localhost:6379/0
# Run Celery tasks inline in the API process (no Redis/worker needed).
SNIPZO_CELERY_EAGER=false
# Signs API tokens and download links. Use a long random value in production.
SNIPZO_SECRET_KEY=dev-insecure-change-me
SNIPZO_PUBLIC_API_URL=http://localhost:8000
SNIPZO_CORS_ORIGINS=http://localhost:3000
# Blob storage: local (default) or s3 (AWS S3, Cloudflare R2, MinIO).
SNIPZO_STORAGE_BACKEND=local
SNIPZO_STORAGE_DIR=./data/blobs
SNIPZO_S3_BUCKET=
SNIPZO_S3_ENDPOINT_URL=
SNIPZO_S3_REGION=auto
SNIPZO_S3_ACCESS_KEY_ID=
SNIPZO_S3_SECRET_ACCESS_KEY=
# Uploaded source videos are deleted after this many days (1-30).
SNIPZO_SOURCE_RETENTION_DAYS=14
SNIPZO_MAX_UPLOAD_MB=2048
